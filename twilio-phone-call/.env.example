# Exotel Account Credentials
# Get these from https://dashboard.exotel.com/
EXOTEL_ACCOUNT_SID=your_exotel_account_sid_here
EXOTEL_API_KEY=your_exotel_api_key_here
EXOTEL_PHONE_NUMBER=040-XXXXXXX

# Base URL for webhooks (production URL)
BASE_URL=https://your-domain.com

# Redis Configuration for Session Storage
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password_here

# Google Gemini AI API Key
# Get from https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Google Cloud Credentials for TTS and STT
# Path to your Google Cloud service account JSON file
GOOGLE_TTS_KEY_FILE=./google-credentials.json

# Server Port
PORT=3000

# MongoDB Connection String
# Get from MongoDB Atlas or use local MongoDB
MONGODB_URI=mongodb://localhost:27017/vidya-vani
